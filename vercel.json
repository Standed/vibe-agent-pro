{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Video Agent Pro"
  },
  "build": {
    "env": {
      "SKIP_ENV_VALIDATION": "1",
      "NODE_VERSION": "20.x"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 120,
      "memory": 2048
    },
    "src/app/api/gemini-grid/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/gemini-image/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/seedream/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/jimeng/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/storyboard/execute/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/admin/sora/repair/route.ts": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-sora-status",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/retry-transfers",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/scan-assets?mode=cron",
      "schedule": "0 0 * * *"
    }
  ]
}